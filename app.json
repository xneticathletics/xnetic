{
  "expo": {
    "name": "X-NETIC",
    "slug": "x-netic",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "xneticclub",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#10122A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.xnetic.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "club.xnetic.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10122A"
      }
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sporcu, profil ve ürün fotoğrafı yükleyebilmen için galerine erişim gerekiyor.",
          "cameraPermission": "X-NETIC kamerana erişmiyor.",
          "microphonePermission": "X-NETIC mikrofonuna erişmiyor."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Antrenman ve müsabaka programını telefonunun takvimine ekleyebilmen için takvimine erişim gerekiyor.",
          "remindersPermission": "X-NETIC hatırlatıcılarına erişmiyor."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "xnetic",
          "project": "react-native"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "014aab5d-6716-4f3a-804f-2f77d8a904fa"
      }
    },
    "owner": "x-netic-sport-systems"
  }
}
