{
  "expo": {
    "name": "X-NETIC Club",
    "slug": "x-netic",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "xneticclub",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#10122A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.xnetic.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "club.xnetic.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10122A"
      }
    },
    "plugins": [
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "014aab5d-6716-4f3a-804f-2f77d8a904fa"
      }
    },
    "owner": "x-netic-sport-systems"
  }
}
